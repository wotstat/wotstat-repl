{
  "name": "wotstat-repl",
  "private": true,
  "version": "1.4.1",
  "type": "module",
  "packageManager": "bun@1.3.14",
  "scripts": {
    "dev": "bunx --bun vite",
    "build": "bunx --bun tsc --noEmit && bunx --bun vite build",
    "build:web": "bunx --bun tsc --noEmit && bunx --bun vite build --mode web --outDir dist-web",
    "preview": "bunx --bun vite preview",
    "preview:web": "bunx --bun vite preview --outDir dist-web",
    "tauri": "bun ./node_modules/@tauri-apps/cli/tauri.js",
    "lint:fsd": "bunx --bun steiger ./src"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.0",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "cmdk": "^1.1.1",
    "monaco-editor": "^0.55.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@feature-sliced/steiger-plugin": "^0.6.0",
    "@tailwindcss/vite": "^4.3.0",
    "@tauri-apps/cli": "^2.11.0",
    "@types/bun": "^1.3.14",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.0",
    "steiger": "^0.5.13",
    "tailwindcss": "^4.3.0",
    "typescript": "^5.6.0",
    "vite": "^8.0.0"
  }
}
